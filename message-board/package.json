{
  "name": "midwayjs-tutorial-message-board",
  "version": "1.0.0",
  "description": "message board - midway v4 (koa) + typeorm + mysql",
  "private": true,
  "dependencies": {
    "@midwayjs/bootstrap": "^4.0.0",
    "@midwayjs/core": "^4.0.0",
    "@midwayjs/info": "^4.0.0",
    "@midwayjs/koa": "^4.0.0",
    "@midwayjs/logger": "^4.0.0",
    "@midwayjs/typeorm": "^4.0.0",
    "@midwayjs/validation": "^4.0.0",
    "@midwayjs/validation-joi": "^4.0.0",
    "@midwayjs/view-ejs": "^4.0.0",
    "joi": "^17.13.3",
    "mysql2": "^3.11.0",
    "typeorm": "^1.0.0"
  },
  "devDependencies": {
    "@midwayjs/mock": "^4.0.0",
    "@types/jest": "^29.2.0",
    "@types/node": "20",
    "cross-env": "^7.0.3",
    "jest": "^29.7.0",
    "mwts": "^2.0.4",
    "mwtsc": "^1.4.0",
    "ts-jest": "^29.4.0",
    "typescript": "^5.3.0"
  },
  "engines": {
    "node": ">=20.0.0"
  },
  "scripts": {
    "start": "cross-env NODE_ENV=production node ./bootstrap.js",
    "dev": "cross-env NODE_ENV=local mwtsc --watch --run @midwayjs/mock/app.js",
    "test": "cross-env NODE_ENV=unittest jest --runInBand --forceExit",
    "cov": "jest --coverage --runInBand --forceExit",
    "lint": "mwts check",
    "lint:fix": "mwts fix",
    "ci": "npm run cov",
    "build": "mwtsc --cleanOutDir"
  },
  "author": "Lellansin",
  "license": "MIT"
}
